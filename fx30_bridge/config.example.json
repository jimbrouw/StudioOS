{
  "host": "0.0.0.0",
  "port": 3030,
  "commandTimeoutSeconds": 90,
  "ingestTimeoutSeconds": 1800,
  "modeSwitchDelaySeconds": 0.5,
  "releaseWarmAfterStop": false,
  "postStopDebounceSeconds": 5,
  "stableFileSeconds": 30,
  "macNotifications": true,
  "openDashboard": true,
  "dashboardHost": "127.0.0.1",
  "proxyExtensions": [".mp4", ".mxf"],
  "obs": {
    "masterFolder": "/Volumes/Extreme SSD/TEST-RECS/OBS-MASTERS",
