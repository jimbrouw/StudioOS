    "copyStableFiles": true,
    "copyAudioStems": true,
    "audioStemsFolder": "AUDIO-STEMS",
    "audioStemsDeliveryFolder": "AUDIO-STEMS",
    "expectedCameraCount": 1,
    "retentionHours": 24
  },
  "zowieResolutionGuard": {
    "enabled": false,
    "requiredWidth": 3840,
    "requiredHeight": 2160,
    "timeoutSeconds": 5,
    "retrySeconds": 30,
